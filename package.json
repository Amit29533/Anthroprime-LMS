{
  "name": "anthroprime-lms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Candidate learning paths connected to the Anthroprime EOD assessment platform.",
  "engines": {
    "node": ">=24.15 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "dev": "node --env-file-if-exists=.env --watch server.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:integration": "node --test tests/eod-integration.test.mjs",
    "seed:demo": "node --env-file-if-exists=.env scripts/seed-demo.mjs",
    "seed:rsa": "node --env-file-if-exists=.env scripts/seed-rsa.mjs"
  },
  "devDependencies": {
    "jsdom": "^29.1.1"
  }
}
